# Copy to .env.local. Never commit that file. Restart npm run dev after edits.
# Supabase Project Settings > API: public URL and publishable key (or legacy anon key).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
# Same public values for server-side token verification; not service-role keys.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
APP_URL=http://localhost:3000
PORT=3000
# Optional. The app works with its deterministic fallback when these are blank.
# Claude Code subscription/login is separate from this app's API credentials.
ANTHROPIC_API_KEY=
# Choose a model ID enabled in YOUR Anthropic API account; do not paste a display name.
ANTHROPIC_MODEL=
